# RAKSHA-AI Backend Environment Variables
ENVIRONMENT=development
PROJECT_NAME="RAKSHA-AI Decision Intelligence Platform"
API_V1_STR=/api
API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL + PostGIS)
# For local dev / testing without PostgreSQL running, SQLite fallback is supported: sqlite:///./raksha_ai.db
DATABASE_URL=postgresql://raksha_user:raksha_password@localhost:5432/raksha_db

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security / Demo Mode
DEMO_MODE=true
DATA_CLASSIFICATION="DEMO / SYNTHETIC DATA"
